// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

/// Always after the prisma-client-js generator
generator json {
  provider = "prisma-json-types-generator"
  // namespace = "PrismaJson"
  // clientOutput = "<finds it automatically>"
  // (./ -> relative to schema, or an importable path to require() it)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// DND 5e data

enum Ability {
  STR
  CON
  DEX
  INT
  WIS
  CHA
}

enum ArmorType {
  LIGHT
  MEDIUM
  HEAVY
  SHIELDS
}

enum Size {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum SpellSchool {
  ABJURATION
  CONJURATION
  DIVINATION
  ENCHANTMENT
  EVOCATION
  ILLUSION
  NECROMANCY
  TRANSMUTATION
}

enum Currency {
  cp
  sp
  ep
  gp
  pp
}

enum Skill {
  ACROBATICS
  ANIMAL_HANDLING
  ARCANA
  ATHLETICS
  DECEPTION
  HISTORY
  INSIGHT
  INTIMIDATION
  INVESTIGATION
  MEDICINE
  NATURE
  PERCEPTION
  PERFORMANCE
  PERSUASION
  RELIGION
  SLEIGHT_OF_HAND
  STEALTH
  SURVIVAL
}

enum Language {
  COMMON
  DWARVISH
  ELVISH
  GIANT
  GNOMISH
  GRUNG
  GOBLIN
  HALFLING
  ORC
  ABYSSAL
  CELESTIAL
  DRACONIC
  WORG
  DEEP_SPEECH
  INFERNAL
  PRIMORDIAL
  SYLVAN
  UNDERCOMMON
  AURAN
  AARAKOCRA
  GITH
  MINOTAUR
  KHENRA
  AQUAN
  NETHERESE
  AVEN
  QUORI
  KOR
  VAMPIRE
  NAGA
  MERFOLK
  SIREN
  DRUIDIC
}

enum Condition {
  BLINDED
  CHARMED
  DEAFENED
  FATIGUED
  FRIGHTENED
  GRAPPLED
  INCAPACITATED
  INVISIBLE
  PARALYZED
  PETRIFIED
  POISONED
  PRONE
  RESTRAINED
  STUNNED
  UNCONSCIOUS
  EXHAUSTION
}

enum DamageTypes {
  ACID
  BLUDGEONING
  COLD
  FIRE
  FORCE
  LIGHTNING
  NECROTIC
  PIERCING
  POISON
  PSYCHIC
  RADIANT
  SLASHING
  THUNDER
  NON_MAGICAL_BLUDGEONING
  NON_MAGICAL_PIERCING
  NON_MAGICAL_SLASHING
  NON_SILVERED_BLUDGEONING
  NON_SILVERED_PIERCING
  NON_SILVERED_SLASHING
  NONE
  OTHER
}

enum CreatureType {
  ABERRATION
  BEAST
  CELESTIAL
  CONSTRUCT
  DRAGON
  ELEMENTAL
  FEY
  FIEND
  GIANT
  HUMANOID
  MONSTROSITY
  OOZE
  PLANT
  UNDEAD
  NULL
}

enum Alignment {
  LAWFUL_GOOD
  NEUTRAL_GOOD
  CHAOTIC_GOOD
  LAWFUL_NEUTRAL
  TRUE_NEUTRAL
  CHAOTIC_NEUTRAL
  LAWFUL_EVIL
  NEUTRAL_EVIL
  CHAOTIC_EVIL
}

enum UserType {
  DISCORD
  NORMAL
}

model User {
  id       String   @id
  username String?  @unique
  email    String?  @unique
  password String?
  type     UserType @default(NORMAL)

  // Discord
  discordId           String?
  discordAvatar       String?
  discordUsername     String?
  discordAccessToken  String?
  discordRefreshToken String?
  discordEmail        String?

  Classes        Class[]
  SubClasses     SubClass[]
  Species        Species[]
  Background     Background[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  likedComments  Comment[]      @relation("LikedComments")
  Spell          Spell[]
  Messages       Message[]
  SubSpecies     SubSpecies[]
  Campaigns      Campaign[]     @relation("PlayerCampaigns")
  GMForCampaigns Campaign[]     @relation("GMCampaigns")
  Tool           Tool[]
  Item           Item[]
  Character      Character[]
  Feat           Feat[]
  Comment        Comment[]
  Creature       Creature[]
  WorkshopItem   WorkshopItem[]
}

// This is what gets saved locally client side, as its to volatile to be saved in the database
// Auto saves will be done periodically to sync the data with the server
model CharacterState {
  id        String    @id
  name      String
  alignment Alignment
  Character Character @relation(fields: [id], references: [id])

  /// [ResourcesUsed]
  resourcesUsed Json

  /// [LogEntry]
  characterLog Json[]

  /// [DiceAmount]
  hitDieUsedSinceLastRest Json[]

  /// [QuantityItem]
  inventory        Json[]
  inspirationRolls Int
  armorEquippedId  String?

  weaponEquippedIds String[]
  shieldEquippedId  String?

  deathSavesSuccess Int
  deathSavesFail    Int

  exhaustion Int

  abilitiesInitialized Boolean @default(false)

  conditions Condition[]

  /// [SpellSlots]
  spellSlotsUsedSinceLastRefresh Json

  //SpellID
  preparedSpellsIds String[]

  /// [ModelLink]
  pendingLinks Json[]

  currentHp Int
  tempHp    Int

  lastSavedIsoString String

  activeFeatureFromGroupsIds String[]

  /// [Note]
  notes             Json[]
  ideals            String[]
  bonds             String[]
  flaws             String[]
  personalityTraits String[]
  biography         String

  imageURL String?

  baseSTR Int
  baseDEX Int
  baseCON Int
  baseINT Int
  baseWIS Int
  baseCHA Int
}

model Character {
  id           String     @id
  Background   Background @relation(fields: [backgroundId], references: [id])
  backgroundId String

  SubClasses SubClass[] @relation("Character subClasses")

  Species      Species     @relation(fields: [speciesId], references: [id])
  speciesId    String
  SubSpecies   SubSpecies? @relation(fields: [subSpeciesId], references: [id])
  subSpeciesId String?

  Feats Feat[]

  createdAt DateTime @default(now())

  User                  User?                   @relation(fields: [userId], references: [id])
  userId                String?
  Campaign              Campaign?               @relation(fields: [campaignId], references: [id])
  campaignId            String?
  CharacterToClass      CharacterToClass[]
  CharacterChoiceStatus CharacterChoiceStatus[]
  Spell                 Spell?                  @relation(fields: [spellId], references: [id])
  spellId               String?
  CharacterState        CharacterState?
}

model CharacterToClass {
  characterId   String
  classId       String
  levelsInClass Int
  primaryClass  Boolean   @default(false)
  Character     Character @relation(fields: [characterId], references: [id])
  Class         Class     @relation(fields: [classId], references: [id])

  @@id([characterId, classId])
}

model Campaign {
  id           String      @id
  name         String
  description  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  GameMaster   User        @relation("GMCampaigns", fields: [gameMasterId], references: [id])
  gameMasterId String
  Players      User[]      @relation("PlayerCampaigns")
  Characters   Character[]
}

enum WeaponGroup {
  ALL_SIMPLE
  ALL_MARTIAL
  ALL_RANGED
  ALL_MELEE
  SIMPLE_MELEE
  SIMPLE_RANGED
  MARTIAL_MELEE
  MARTIAL_RANGED
  ALL_WEAPONS
}

enum ToolGroup {
  ARTISANS_TOOLS
  GAMING_SETS
  INSTRUMENTS
  VEHICLES
}

model Class {
  id  String  @id
  srd Boolean @default(false)

  name        String
  description String
  flavorText  String @db.VarChar(200)
  source      String @default("Player's Handbook") //source of the class

  hitDie Int

  SubClasses            SubClass[]
  subClassName          String
  subClassDescription   String
  subClassFeatureLevels Int[]

  Features             Feature[] @relation("ClassFeatures")
  SpellcastingFeatures Feature[] @relation("SpellCastingFeatures")

  savingThrowDescription       String
  freeSavingThrowProficiencies Ability[]

  skillDescription String
  freeSkills       Skill[]

  toolProficiencyDescription String
  freeToolProficiencyGroups  ToolGroup[]
  freeToolProficiencyIds     String[]

  armorProficiencyDescription String
  freeArmorProficiencies      ArmorType[]

  weaponProficiencyDescription String
  freeWeaponProficiencyIds     String[]
  freeWeaponProficiencyGroups  WeaponGroup[]

  itemDescription String[]

  /// [QuantityItem]
  freeItemIds Json[]

  abilityScoreLevels Int[]

  Choices Choice[]

  User            User?             @relation(fields: [userId], references: [id])
  userId          String?
  ColumnedFeature ColumnedFeature[]

  slug             String             @unique @db.VarChar(200)
  CharacterToClass CharacterToClass[]
  MultiClassing    MultiClassingInfo?
  SpellCasting     SpellCasting?
}

enum SpellFocus {
  ARCANE_FOCUS
  DRUIDIC_FOCUS
  HOLY_SYMBOL
  COMPONENT_POUCH
  MUSICAL_INSTRUMENT
  ARTISANS_TOOLS
}

enum CasterPower {
  FULL
  HALF_ROUNDED_UP
  HALF_ROUNDED_DOWN
  THIRD_ROUNDED_UP
  THIRD_ROUNDED_DOWN
  CUSTOM
}

enum CasterType {
  PREPARED
  KNOWN
}

model SpellCasting {
  id         String    @id
  classId    String?   @unique
  Class      Class?    @relation(fields: [classId], references: [id])
  subclassId String?   @unique
  SubClass   SubClass? @relation(fields: [subclassId], references: [id])

  SpellList            SpellList? @relation(fields: [spellListId], references: [id]) // If the class has a spell list, link it here
  spellListId          String?
  spellListDescription String?

  description                    String
  preparingSpellsDescription     String?
  castingSpellsDescription       String?
  spellCastingAbilityDescription String?
  ability                        Ability
  spellFocus                     SpellFocus?
  spellFocusDescription          String?

  casterPower CasterPower
  casterType  CasterType

  /// [SpellLevels]
  customCasterSpellLevels Json?
}

model MultiClassingInfo {
  classId                  String @id
  Class                    Class  @relation(fields: [classId], references: [id])
  multiclassingDescription String

  /// [Prerequisite]
  prerequisite Json

  freeSkillProficiencies       Skill[]
  freeToolIdProficiencies      String[]
  freeToolGroupProficiencies   ToolGroup[]
  freeLanguages                Language[]
  freeArmorProficiencies       ArmorType[]
  freeWeaponGroupProficiencies WeaponGroup[]
  freeWeaponIdProficiencies    String[]
  freeSavingThrowProficiencies Ability[]

  Choices Choice[]
}

enum ChoiceProtocol {
  SET_COMPREHENSIVE_HALF_PROFICIENCY
  SET_COMPREHENSIVE_PROFICIENCY
  SET_COMPREHENSIVE_EXPERTISE
  SET_SKILL_HALF_PROFICIENCY
  SET_SKILL_PROFICIENCY
  SET_SKILL_EXPERTISE
  UPGRADE_SKILL_PROFICIENCY_TO_EXPERTISE
  SET_TOOL_PROFICIENCY
  SET_TOOL_PROFICIENCY_GROUPED
  SET_SAVING_THROW_PROFICIENCY
  SET_ARMOR_PROFICIENCY
  SET_WEAPON_PROFICIENCY
  SET_WEAPON_PROFICIENCY_GROUPED
  ADD_TO_INVENTORY
  ADD_TO_INVENTORY_GROUPED
  SET_LANGUAGE_PROFICIENCY
  SET_ABILITY_SCORE
  IMPROVE_ABILITY_SCORE
  ADD_FREE_SPELL
  ADD_KNOWN_SPELL
  CHOOSE_SUBCLASS
  SET_FEAT_OR_ASI
}

model Choice {
  id          String @id
  description String //The Choice in human readable form

  amountOfOptionToChoose Int
  CharacterChoiceStatus  CharacterChoiceStatus[]

  protocol    ChoiceProtocol // Describes How to handle the choice parameters, and what callback to invoke
  /// [ChoiceFetchParams]
  fetchParams Json //The parameters that will be used to fetch the choice

  Class         Class?             @relation(fields: [classId], references: [id])
  classId       String?
  Species       Species?           @relation(fields: [speciesId], references: [id])
  speciesId     String?
  SubSpecies    SubSpecies?        @relation(fields: [subSpeciesId], references: [id])
  subSpeciesId  String?
  Background    Background?        @relation(fields: [backgroundId], references: [id])
  backgroundId  String?
  MultiClassing MultiClassingInfo? @relation(fields: [multiClassId], references: [classId])
  multiClassId  String?
  Effect        Effect?            @relation(fields: [effectId], references: [id])
  effectId      String?
}

model CharacterChoiceStatus {
  characterId String
  choiceId    String

  /// [ChoiceFetchOutput]
  values Json

  Character Character @relation(fields: [characterId], references: [id])
  Choice    Choice    @relation(fields: [choiceId], references: [id])

  @@id([characterId, choiceId])
}

model Spell {
  id            String       @id
  srd           Boolean      @default(false)
  name          String
  description   String
  duration      String
  range         String
  castingTime   String
  verbal        Boolean      @default(false)
  somatic       Boolean      @default(false)
  material      Boolean      @default(false)
  materialCost  String?
  concentration Boolean      @default(false)
  ritual        Boolean      @default(false)
  rolls         String[]
  upcastInfo    String?
  //search fields
  tags          String[]
  saveRequired  Boolean      @default(false)
  damageType    DamageTypes?
  aoe           Boolean      @default(false)
  conditions    String[]
  options       String[] // If the spell has options to choose from, list here  
  /// [Table]
  extendedTable Json[] // This table will be rendered with the spell
  postTableData String? // This is for any additional content that should be displayed after the table
  school        SpellSchool
  level         Int //0 is cantrip, 1-9 are spell levels
  source        String

  User                 User?                  @relation(fields: [userId], references: [id])
  userId               String?
  SpellLists           SpellList[]
  Item                 Item[]                 @relation("SpellScroll")
  PreparedByCreature   Creature[]             @relation("CreaturePrepares")
  FreelyCastByCreature Creature[]             @relation("CreatureFreelyCasts")
  CreatureLimitedSpell CreatureLimitedSpell[]

  slug          String          @unique @db.VarChar(200)
  Character     Character[]
  characterId   String?
  EffectToSpell EffectToSpell[]
}

model SpellList {
  id          String @id
  name        String
  flavorText  String @db.VarChar(200)
  description String

  Spells Spell[]

  slug         String         @unique @db.VarChar(200)
  SpellCasting SpellCasting[]
}

model Feature {
  id                        String                    @id
  workshopId                String?                   @unique
  WorkshopItem              WorkshopItem?             @relation(fields: [workshopId], references: [id])
  name                      String
  description               String
  options                   String[]
  /// [Table]
  extendedTable             Json[]
  postTableData             String?
  unimplemented             Boolean                   @default(false)
  SubClass                  SubClass?                 @relation("SubClassFeatures", fields: [subClassId], references: [id])
  subClassId                String?
  SpellCastingSubclass      SubClass?                 @relation("SpellCastingFeatures", fields: [spellCastingSubclassId], references: [id])
  spellCastingSubclassId    String?
  Species                   Species?                  @relation(fields: [speciesId], references: [id])
  speciesId                 String?
  Class                     Class?                    @relation("ClassFeatures", fields: [classId], references: [id])
  classId                   String?
  SpellCastingClass         Class?                    @relation("SpellCastingFeatures", fields: [spellCastingClassId], references: [id])
  spellCastingClassId       String?
  Feat                      Feat?                     @relation(fields: [featId], references: [id])
  featId                    String?
  Tool                      Tool?                     @relation(fields: [toolId], references: [id])
  toolId                    String?
  Item                      Item?                     @relation(fields: [itemId], references: [id])
  itemId                    String?
  Armor                     Armor?                    @relation(fields: [armorId], references: [id])
  armorId                   String?
  Creature                  Creature?                 @relation(fields: [creatureId], references: [id])
  creatureId                String?
  SubSpecies                SubSpecies?               @relation(fields: [subSpeciesId], references: [id])
  subSpeciesId              String?
  Background                Background?               @relation(fields: [backgroundId], references: [id])
  backgroundId              String?
  Weapon                    Weapon?                   @relation(fields: [weaponId], references: [id])
  weaponId                  String?
  columnedFeatures          ColumnedFeature[]
  SubClassColumnedFeature   SubClassColumnedFeature[]
  FeatureGroup              FeatureGroup?             @relation(fields: [FeatureGroupId], references: [id])
  FeatureGroupId            String?
  Effects                   Effect[]
  effectChainType           ChainType                 @default(NONE)
  EffectGrantsGroup         EffectGrantsGroup?        @relation(fields: [effectGrantsGroupEffectId, effectGrantsGroupGroupId], references: [effectId, groupId])
  effectGrantsGroupEffectId String?
  effectGrantsGroupGroupId  String?
}

// Toggleable features. You can only have one feature from this group active at a time
model FeatureGroup {
  id                String              @id
  name              String
  description       String
  flavorText        String              @db.VarChar(200)
  slug              String              @unique @db.VarChar(200)
  FeaturesInGroup   Feature[]
  EffectGrantsGroup EffectGrantsGroup[]
}

enum ChainType {
  REPLACE //Voids the previous effect
  ADD //Adds to the previous effect
  NONE // Only one effect. No chain
}

//Represents a feature effect that grants x choices to the user from a feature group
//ex pick 2 fighting styles.
model EffectGrantsGroup {
  effectId String
  groupId  String

  amount Int

  // If length is 0, the user can pick any feature from the group
  FeaturesToChooseFrom Feature[]

  Effect       Effect       @relation(fields: [effectId], references: [id])
  FeatureGroup FeatureGroup @relation(fields: [groupId], references: [id])

  @@id([effectId, groupId])
}

enum RitualCasterType {
  ALL
  PREPARED
  KNOWN
}

// Effects define how the feature interacts with character data
model Effect {
  id    String @id
  level Int

  rollFormulas String[]

  /// [Prerequisite]
  preRequisite Json?

  // Chained Effects are effects that override
  chainedEffect   Effect? @relation("ChainedEffect", fields: [chainedEffectId], references: [id])
  chainedEffectId String? @unique

  multiAttackAmount Int?

  ritualCasterType            RitualCasterType?
  halfSkillProficiencies      Skill[]
  fullSkillProficiencies      Skill[]
  expertiseSkillProficiencies Skill[]

  languageProficiencies    Language[]
  toolProficienciesIds     String[]
  weaponGroupProficiencies WeaponGroup[]

  weaponGroupRef     WeaponGroup?
  attackModifier     String?
  damageModifier     String?
  damageModifierType DamageTypes?

  unarmedAttack     String? //if there is both unarmed attack, damage and damagetype, it will be added to the character sheet
  unarmedDamage     String?
  twoHandedDamage   String?
  unarmedDamageType DamageTypes?
  unarmedModifier   String? //Flat mod to add to all unarmed attacks.

  /// [AbilityScoreValue]
  abilityScoreImprovements Json[]

  speedBonusFormula      String?
  initiativeBonusFormula String?

  blindsight  Int?
  darkvision  Int?
  tremorsense Int?
  truesight   Int?

  acBonusFormula String?

  Choices Choice[]

  EffectToResource  EffectToResource[]
  Feature           Feature             @relation(fields: [featureId], references: [id])
  parentEffect      Effect?             @relation("ChainedEffect")
  EffectGrantsGroup EffectGrantsGroup[]
  EffectToSpell     EffectToSpell[]
  EffectGrantsFeat  EffectGrantsFeat[]
  featureId         String
}

model EffectGrantsFeat {
  effectId String
  featId   String

  Effect Effect @relation(fields: [effectId], references: [id])
  Feat   Feat   @relation(fields: [featId], references: [id])

  @@id([effectId, featId])
}

model EffectToSpell {
  effectId String
  spellId  String

  requireMaterial  Boolean @default(true)
  requireSpellSlot Boolean @default(true)

  amountBeforeRest Int? //Blank for infinite
  restType         RefreshEvent?

  Effect Effect @relation(fields: [effectId], references: [id])
  Spell  Spell  @relation(fields: [spellId], references: [id])

  @@id([effectId, spellId])
}

enum RefreshEvent {
  SHORT_REST
  LONG_REST
  TURN
  ROUND
  OTHER
}

//If an effect is attached to a resource, the amount will be added to the resource tracker on the sheet. 
model EffectToResource {
  effectId   String
  resourceId String

  //ex 2 + {prof} * 2 / (8 * {STR}) + {level}
  scalingFormula String

  refreshOn RefreshEvent
  Effect    Effect         @relation(fields: [effectId], references: [id])
  Resource  CustomResource @relation(fields: [resourceId], references: [id])

  @@id([effectId, resourceId])
}

// Custom Resources are resources that are tracked on the character sheet. Such as Ki points, Sorcery points, etc
model CustomResource {
  id          String @id
  name        String
  description String
  slug        String @unique @db.VarChar(200)

  EffectToResource EffectToResource[]
}

model ColumnedFeature {
  classId   String
  Class     Class    @relation(fields: [classId], references: [id])
  featureId String
  Feature   Feature  @relation(fields: [featureId], references: [id])
  name      String
  rows      String[]

  @@id([classId, featureId])
}

model SubClassColumnedFeature {
  id         String   @id
  subClassId String
  SubClass   SubClass @relation(fields: [subClassId], references: [id])
  featureId  String
  Feature    Feature  @relation(fields: [featureId], references: [id])
  name       String
  rows       String[]
}

model SubClass {
  id  String  @id
  srd Boolean @default(false)

  name        String
  description String
  flavorText  String @db.VarChar(200)
  source      String @default("Player's Handbook")

  Class   Class   @relation(fields: [classId], references: [id])
  classId String
  User    User?   @relation(fields: [userId], references: [id])
  userId  String?

  Character               Character[]               @relation("Character subClasses")
  Features                Feature[]                 @relation("SubClassFeatures")
  SpellCastingFeatures    Feature[]                 @relation("SpellCastingFeatures")
  SubClassColumnedFeature SubClassColumnedFeature[]

  WorkshopItem WorkshopItem? @relation(fields: [workshopId], references: [id])
  workshopId   String?       @unique

  slug         String        @unique @db.VarChar(200)
  SpellCasting SpellCasting?
}

model Species {
  id          String  @id
  srd         Boolean @default(false)
  name        String
  description String
  flavorText  String  @db.VarChar(200)
  source      String

  Features Feature[]

  Choices Choice[]

  /// [AbilityScoreValue]
  freeAbilityScoreImprovements Json[]
  abilityScoreDescription      String

  creatureType    CreatureType
  size            Size
  sizeDescription String?

  age       String
  alignment String

  speed       Int
  flightSpeed Int?
  swimSpeed   Int?
  climbSpeed  Int?
  burrowSpeed Int?

  speedDescription       String
  flightDescription      String?
  swimDescription        String?
  climbDescription       String?
  burrowSpeedDescription String?

  darkvision            Int?
  darkvisionDescription String?

  blindSight            Int?
  blindSightDescription String?

  trueSight            Int?
  trueSightDescription String?

  tremorSense            Int?
  tremorSenseDescription String?

  freeLanguages       Language[]
  languageDescription String?

  Variants SubSpecies[]

  User      User?       @relation(fields: [userId], references: [id])
  userId    String?
  Character Character[]

  slug String @unique @db.VarChar(200)
}

model SubSpecies {
  id          String  @id
  srd         Boolean @default(false)
  name        String
  description String
  flavorText  String  @db.VarChar(200)
  source      String

  Features Feature[]

  Choices Choice[]

  /// [AbilityScoreValue]
  freeAbilityScoreImprovements Json[]
  abilityScoreDescription      String?

  creatureType    CreatureType?
  size            Size?
  sizeDescription String?

  age       String?
  alignment String?

  speed       Int?
  flightSpeed Int?
  swimSpeed   Int?
  climbSpeed  Int?
  burrowSpeed Int?

  speedDescription       String?
  flightDescription      String?
  swimDescription        String?
  climbDescription       String?
  burrowSpeedDescription String?

  darkvision            Int?
  darkvisionDescription String?

  blindSight            Int?
  blindSightDescription String?

  trueSight            Int?
  trueSightDescription String?

  tremorSense            Int?
  tremorSenseDescription String?

  freeLanguages       Language[]
  languageDescription String?

  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  species   Species     @relation(fields: [speciesId], references: [id])
  speciesId String
  Character Character[]

  slug String @unique @db.VarChar(200)
}

model Background {
  id String @id

  srd         Boolean @default(false)
  name        String
  description String
  source      String  @default("Player's Handbook")
  flavorText  String  @db.VarChar(200)

  Choices Choice[]

  freeSkillProficiencies      Skill[]
  skillProficiencyDescription String?

  freeToolProficiencyGroups  ToolGroup[]
  freeToolProficiencyIds     String[]
  toolProficiencyDescription String?

  freeLanguageProficiencies      Language[]
  languageProficiencyDescription String?

  /// [QuantityItem]
  freeEquipment        Json[]
  equipmentDescription String[]

  Features Feature[]

  suggestedCharacteristics String?
  traits                   String[]
  ideals                   String[]
  bonds                    String[]
  flaws                    String[]
  User                     User?         @relation(fields: [userId], references: [id])
  userId                   String?
  Character                Character[]
  WorkshopItem             WorkshopItem? @relation(fields: [workshopItemId], references: [id])
  workshopItemId           String?       @unique
  slug                     String        @unique @db.VarChar(200)
}

model Feat {
  id           String        @id
  workshopId   String?       @unique
  WorkshopItem WorkshopItem? @relation(fields: [workshopId], references: [id])
  name         String

  Features          Feature[]
  flavorText        String    @db.VarChar(200)
  source            String
  /// [Prerequisite]
  prerequisites     Json?
  prereqDescription String

  User       User?       @relation(fields: [userId], references: [id])
  userId     String?
  Characters Character[]

  slug             String             @unique @db.VarChar(200)
  EffectGrantsFeat EffectGrantsFeat[]
}

model Message {
  id        String   @id
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  email     String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id   String @id
  name String

  /// [ToolSkill]
  skills Json[]

  components            String[] // Some tools have components that the character gets. These will be automatically added into the characters sheet
  componentsDescription String? // Description of the components

  Features Feature[]

  Items     Item[]
  ToolGroup ToolGroup?

  User   User?   @relation(fields: [userId], references: [id])
  userId String?
}

enum ItemTypes {
  MAGIC
  CLOTHES
  ARCANE_FOCUS
  DRUIDIC_FOCUS
  HOLY_SYMBOL
  CONTAINER
  WEAPON
  ARMOR
  AMMUNITION
  COMPONENT_POUCH
  SPELL_BOOK
  EXPLOSIVE
  EQUIPMENT_PACK
  MISC
  TOOL
  CURRENCY
  SPELL_SCROLL
  GEMSTONE
  WONDROUS_ITEM
  AMULET
  BELT
  BOOTS
  BRACERS
  CLOAK
  WORKSHOP
}

enum Unit {
  lb
  oz
  pint
  quart
  gal
}

model EquipmentPack {
  id   String @id
  name String

  /// [QuantityItem]
  itemsQuantity Json[] //describes how many of each item is in the pack
  itemList      Item[] @relation("EquipmentPackParent")

  items Item[] @relation("EquipmentPackChild")
}

model Item {
  id                 String  @id
  name               String
  description        String
  slug               String  @unique @db.VarChar(200)
  flavorText         String  @db.VarChar(200)
  requiresAttunement Boolean @default(false)
  rarity             Rarity
  /// [CurrencyAmount]
  cost               Json?

  /// [QuantityUnit]
  weight Json?

  /// [QuantityUnit]
  capacity Json?

  // unique item storage

  /// [QuantityItem]
  customItemCapacity Json?

  Features Feature[]

  types ItemTypes[]

  // the item can be part of an equipment pack
  EquipmentPackList EquipmentPack[] @relation("EquipmentPackParent")
  //the item can be an equipment pack
  EquipmentPack     EquipmentPack?  @relation("EquipmentPackChild", fields: [equipmentPackId], references: [id])
  equipmentPackId   String?

  // if the item is a tool we can link it to the tool model
  Tool   Tool?   @relation(fields: [toolId], references: [id])
  toolId String?

  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  Spell   Spell?  @relation("SpellScroll", fields: [spellId], references: [id])
  spellId String?

  AmmunitionFor Weapon[] @relation("WeaponAmmunition")
  Armor         Armor?   @relation("ItemArmor", fields: [armorId], references: [id])
  armorId       String?

  CreatureWielding Creature[]      @relation("CreatureWields")
  CreatureArmor    Creature[]      @relation("CreatureArmor")
  CreatureShield   Creature[]      @relation("CreatureShield")
  ItemWeaponData   ItemWeaponData?

  workshopId   String?       @unique
  WorkshopItem WorkshopItem? @relation(fields: [workshopId], references: [id])
}

model ItemWeaponData {
  itemId   String  @unique
  Item     Item    @relation(fields: [itemId], references: [id])
  weaponId String
  Weapon   Weapon  @relation(fields: [weaponId], references: [id])
  silvered Boolean @default(false)
  magical  Boolean @default(false)

  @@id([itemId, weaponId])
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
  ARTIFACT
}

//es Finessed, Light, Thrown etc
model WeaponProperty {
  id                     String                   @id
  name                   String
  description            String
  WeaponPropertyInstance WeaponPropertyInstance[]
}

model WeaponPropertyInstance {
  // composite key
  weaponId   String
  propertyId String
  Weapon     Weapon         @relation(fields: [weaponId], references: [id])
  Property   WeaponProperty @relation(fields: [propertyId], references: [id])
  range      String?

  versatileDamage String?

  @@id([weaponId, propertyId])
}

model Weapon {
  id   String @id
  name String

  // if the weapon is simple or martial
  isSimple Boolean
  isRanged Boolean?

  damage     String
  damageType DamageTypes

  ammunition   Item?   @relation("WeaponAmmunition", fields: [ammunitionId], references: [id])
  ammunitionId String?

  SpecialProperties      Feature[]
  WeaponPropertyInstance WeaponPropertyInstance[]
  ItemWeaponData         ItemWeaponData[]
}

model Armor {
  id   String @id
  name String

  armorClass Int
  armorType  ArmorType

  Features Feature[]
  Item     Item[]    @relation("ItemArmor")
}

model BlogPost {
  id              String @id
  title           String
  route           String @unique
  meta            String @db.VarChar(200)
  flavorText      String @db.VarChar(400)
  content         String //markdown
  /// [TableOfContentItem]
  tableOfContents Json[] // array of objects with title and link

  ImageURL String
  ImageAlt String
}

enum CommentType {
  COMMENT
  REPLY
}

enum AssociatedModel {
  ITEM
  FEAT
  CLASS
  SUBCLASS
  SPECIES
  SUBSPECIES
  BACKGROUND
  SPELL
  SPELL_LIST
  CREATURE
}

model Comment {
  id      String @id
  User    User   @relation(fields: [userId], references: [id])
  userId  String
  comment String

  parentComment   Comment?  @relation("ParentComment", fields: [parentCommentId], references: [id])
  parentCommentId String?
  replies         Comment[] @relation("ParentComment")
  likedBy         User[]    @relation("LikedComments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CommentType CommentType
  model       AssociatedModel

  modelId String
}

enum ArmorClassProtocol {
  REGULAR
  NATURAL_ARMOR
}

model Creature {
  id          String @id
  name        String
  description String
  flavorText  String @db.VarChar(200)
  STR         Int
  DEX         Int
  CON         Int
  INT         Int
  WIS         Int
  CHA         Int

  languageDescription String?

  armorClassDescription String?
  armorClassProtocol    ArmorClassProtocol @default(REGULAR)
  shield                Boolean            @default(false)
  naturalArmorBonus     Int?

  hitDiceAmount Int

  creatureType         CreatureType
  size                 Size
  alignmentDescription String?
  alignmentOptions     Alignment[]

  spellcastingAbility Ability?
  casterLevel         Int?

  saveProficiencies Ability[]

  skillProficiencies Skill[]
  skillExpertise     Skill[]

  wieldingItems Item[] @relation("CreatureWields")

  armorEquipped   Item?   @relation("CreatureArmor", fields: [armorEquippedId], references: [id])
  armorEquippedId String?

  shieldEquipped   Item?   @relation("CreatureShield", fields: [shieldEquippedId], references: [id])
  shieldEquippedId String?

  spellsPrepared Spell[] @relation("CreaturePrepares")
  freeSpells     Spell[] @relation("CreatureFreelyCasts")

  speed                     Int
  speedDescription          String?
  climbingSpeed             Int?
  climbingSpeedDescription  String?
  flyingSpeed               Int?
  flyingSpeedDescription    String?
  swimmingSpeed             Int?
  swimmingSpeedDescription  String?
  burrowingSpeed            Int?
  burrowingSpeedDescription String?

  darkvision            Int?
  darkvisionDescription String?

  blindsight            Int?
  blindsightDescription String?

  trueSight            Int?
  trueSightDescription String?

  tremorsense            Int?
  tremorsenseDescription String?

  challengeRating Float

  damageImmunities      DamageTypes[]
  damageResistances     DamageTypes[]
  damageVulnerabilities DamageTypes[]

  conditionImmunities String[]

  legendaryActionAmount Int?
  /// [LegendaryAction]
  legendaryActions      Json[]

  Features Feature[]

  /// [CreatureAction]
  actions Json[]

  CreatureLimitedSpells CreatureLimitedSpell[]

  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  slug String @unique @db.VarChar(200)
}

enum Time {
  ACTION
  BONUS_ACTION
  REACTION
  ROUND
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

model CreatureLimitedSpell {
  creatureId String
  spellId    String
  amount     Int
  time       Time
  Creature   Creature @relation(fields: [creatureId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Spell      Spell    @relation(fields: [spellId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([creatureId, spellId])
}

enum WorkshopProtocol {
  SPELL
  ITEM
  CREATURE
  CLASS
  SUBCLASS
  SPECIES
  SUBSPECIES
  BACKGROUND
  FEAT
  FEATURE
}

model WorkshopItem {
  id   String @id
  /// [WorkshopItemData]
  data Json

  User   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())
  Feature   Feature?
  Feat      Feat?

  Item       Item?
  SubClass   SubClass?
  Background Background?
}

//Prisma wont create enum types if they are not in a model, so this is a dummy model
model Enums {
  id                 Int                @id @default(autoincrement())
  protocol           WorkshopProtocol
  skill              Skill
  ability            Ability
  armorType          ArmorType
  size               Size
  spellSchool        SpellSchool
  currency           Currency
  damageTypes        DamageTypes
  creatureType       CreatureType
  alignment          Alignment
  language           Language
  rarity             Rarity
  itemTypes          ItemTypes
  unit               Unit
  commentType        CommentType
  associatedModel    AssociatedModel
  armorClassProtocol ArmorClassProtocol
  conditions         Condition
}
