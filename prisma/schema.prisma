// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

/// Always after the prisma-client-js generator
generator json {
  provider = "prisma-json-types-generator"
  // namespace = "PrismaJson"
  // clientOutput = "<finds it automatically>"
  // (./ -> relative to schema, or an importable path to require() it)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// DND 5e data

enum Ability {
  STR
  CON
  DEX
  INT
  WIS
  CHA
}

enum ArmorType {
  LIGHT
  MEDIUM
  HEAVY
  SHIELDS
}

enum Size {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum SpellSchool {
  ABJURATION
  CONJURATION
  DIVINATION
  ENCHANTMENT
  EVOCATION
  ILLUSION
  NECROMANCY
  TRANSMUTATION
}

enum Currency {
  cp
  sp
  ep
  gp
  pp
}

enum Skill {
  ACROBATICS
  ANIMAL_HANDLING
  ARCANA
  ATHLETICS
  DECEPTION
  HISTORY
  INSIGHT
  INTIMIDATION
  INVESTIGATION
  MEDICINE
  NATURE
  PERCEPTION
  PERFORMANCE
  PERSUASION
  RELIGION
  SLEIGHT_OF_HAND
  STEALTH
  SURVIVAL
}

enum Language {
  COMMON
  DWARVISH
  ELVISH
  GIANT
  GNOMISH
  GRUNG
  GOBLIN
  HALFLING
  ORC
  ABYSSAL
  CELESTIAL
  DRACONIC
  WORG
  DEEP_SPEECH
  INFERNAL
  PRIMORDIAL
  SYLVAN
  UNDERCOMMON
  AURAN
  AARAKOCRA
  GITH
  MINOTAUR
  KHENRA
  AQUAN
  NETHERESE
  AVEN
  QUORI
  KOR
  VAMPIRE
  NAGA
  MERFOLK
  SIREN
}

enum Condition {
  BLINDED
  CHARMED
  DEAFENED
  FATIGUED
  FRIGHTENED
  GRAPPLED
  INCAPACITATED
  INVISIBLE
  PARALYZED
  PETRIFIED
  POISONED
  PRONE
  RESTRAINED
  STUNNED
  UNCONSCIOUS
  EXHAUSTION
}

enum DamageTypes {
  ACID
  BLUDGEONING
  COLD
  FIRE
  FORCE
  LIGHTNING
  NECROTIC
  PIERCING
  POISON
  PSYCHIC
  RADIANT
  SLASHING
  THUNDER
  NON_MAGICAL_BLUDGEONING
  NON_MAGICAL_PIERCING
  NON_MAGICAL_SLASHING
  NON_SILVERED_BLUDGEONING
  NON_SILVERED_PIERCING
  NON_SILVERED_SLASHING
  NONE
  OTHER
}

enum CreatureType {
  ABERRATION
  BEAST
  CELESTIAL
  CONSTRUCT
  DRAGON
  ELEMENTAL
  FEY
  FIEND
  GIANT
  HUMANOID
  MONSTROSITY
  OOZE
  PLANT
  UNDEAD
  NULL
}

enum Alignment {
  LAWFUL_GOOD
  NEUTRAL_GOOD
  CHAOTIC_GOOD
  LAWFUL_NEUTRAL
  TRUE_NEUTRAL
  CHAOTIC_NEUTRAL
  LAWFUL_EVIL
  NEUTRAL_EVIL
  CHAOTIC_EVIL
}

model User {
  id             String         @id
  username       String         @unique
  email          String         @unique
  password       String
  Classes        Class[]
  SubClasses     SubClass[]
  Species        Species[]
  Background     Background[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  likedComments  Comment[]      @relation("LikedComments")
  Spell          Spell[]
  Messages       Message[]
  SubSpecies     SubSpecies[]
  Campaigns      Campaign[]     @relation("PlayerCampaigns")
  GMForCampaigns Campaign[]     @relation("GMCampaigns")
  Tool           Tool[]
  Item           Item[]
  Character      Character[]
  Feat           Feat[]
  Comment        Comment[]
  Creature       Creature[]
  WorkshopItem   WorkshopItem[]
}

model Character {
  id           String     @id
  name         String
  imageURL     String?
  alignment    Alignment
  Background   Background @relation(fields: [backgroundId], references: [id])
  backgroundId String

  SubClasses SubClass[] @relation("Character subClasses")

  Species      Species     @relation(fields: [speciesId], references: [id])
  speciesId    String
  SubSpecies   SubSpecies? @relation(fields: [subSpeciesId], references: [id])
  subSpeciesId String?

  Feats Feat[]

  notes             String[]
  ideals            String[]
  bonds             String[]
  flaws             String[]
  personalityTraits String[]
  biography         String

  inspirationRolls Int

  /// [DiceAmount]
  hitDieUsedSinceLastRest Json[]

  /// [QuantityItem]
  inventory Json[]

  baseSTR Int
  baseDEX Int
  baseCON Int
  baseINT Int
  baseWIS Int
  baseCHA Int

  armorEquippedId String?

  weaponEquippedIds String[]

  deathSavesSuccess Int
  deathSavesFail    Int

  exhaustion Int

  conditions Condition[]

  preparedSpells Spell[]

  maxHp     Int
  currentHp Int
  tempHp    Int

  /// [Choice]
  pendingChoices Json[]

  createdAt          DateTime @default(now())
  updatedAtIsoString String?

  User                  User?                   @relation(fields: [userId], references: [id])
  userId                String?
  Campaign              Campaign?               @relation(fields: [campaignId], references: [id])
  campaignId            String?
  CharacterToClass      CharacterToClass[]
  CharacterChoiceStatus CharacterChoiceStatus[]
}

model CharacterToClass {
  characterId   String
  classId       String
  levelsInClass Int
  Character     Character @relation(fields: [characterId], references: [id])
  Class         Class     @relation(fields: [classId], references: [id])

  @@id([characterId, classId])
}

model Campaign {
  id           String      @id
  name         String
  description  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  GameMaster   User        @relation("GMCampaigns", fields: [gameMasterId], references: [id])
  gameMasterId String
  Players      User[]      @relation("PlayerCampaigns")
  Characters   Character[]
}

enum WeaponGroup {
  ALL_SIMPLE
  ALL_MARTIAL
  ALL_RANGED
  ALL_MELEE
  SIMPLE_MELEE
  SIMPLE_RANGED
  MARTIAL_MELEE
  MARTIAL_RANGED
  ALL_WEAPONS
}

enum ToolGroup {
  ARTISANS_TOOLS
  GAMING_SETS
  INSTRUMENTS
  VEHICLES
}

model Class {
  id  String  @id
  srd Boolean @default(false)

  name                     String
  description              String
  flavorText               String @db.VarChar(200)
  /// [AbilityScoreTrigger]
  multiclassing            Json
  multiclassingDescription String
  source                   String @default("Player's Handbook") //source of the class

  hitDie Int

  SubClasses            SubClass[]
  subClassName          String
  subClassDescription   String
  subClassFeatureLevels Int[]

  Features             Feature[] @relation("ClassFeatures")
  SpellcastingFeatures Feature[] @relation("SpellCastingFeatures")

  savingThrowDescription       String
  freeSavingThrowProficiencies Ability[]

  skillDescription String
  freeSkills       Skill[]

  toolProficiencyDescription String
  freeToolProficiencyGroups  ToolGroup[]
  freeToolProficiencyIds     String[]

  armorProficiencyDescription String
  freeArmorProficiencies      ArmorType[]

  weaponProficiencyDescription String
  freeWeaponProficiencyIds     String[]
  freeWeaponProficiencyGroups  WeaponGroup[]

  itemDescription String[]

  /// [QuantityItem]
  freeItemIds Json[]

  abilityScoreLevels Int[]

  Choices Choice[]

  isSpellCaster    Boolean @default(false)
  /// [SpellCastingInfo]
  spellCastingInfo Json? //only exists if isSpellCaster is true

  SpellList            SpellList? @relation(fields: [spellListId], references: [id]) // If the class has a spell list, link it here
  spellListId          String?
  spellListDescription String?

  //date fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User            User?             @relation(fields: [userId], references: [id])
  userId          String?
  ColumnedFeature ColumnedFeature[]

  slug             String             @unique @db.VarChar(200)
  CharacterToClass CharacterToClass[]
}

enum ChoiceProtocol {
  SET_SKILL_PROFICIENCY
  SET_SKILL_EXPERTISE
  SET_TOOL_PROFICIENCY
  SET_TOOL_PROFICIENCY_GROUPED
  SET_SAVING_THROW_PROFICIENCY
  SET_ARMOR_PROFICIENCY
  SET_WEAPON_PROFICIENCY
  ADD_TO_INVENTORY
  ADD_TO_INVENTORY_GROUPED
  SET_LANGUAGE_PROFICIENCY
  SET_ABILITY_SCORE
}

model Choice {
  id          String @id
  description String //The Choice in human readable form

  amountOfOptionToChoose Int
  CharacterChoiceStatus  CharacterChoiceStatus[]

  protocol    ChoiceProtocol // Describes How to handle the choice parameters, and what callback to invoke
  /// [ChoiceFetchParams]
  fetchParams Json //The parameters that will be used to fetch the choice

  Class   Class?  @relation(fields: [classId], references: [id])
  classId String?
}

model CharacterChoiceStatus {
  characterId String
  choiceId    String

  fufilled Boolean
  values   Json[]

  Character Character @relation(fields: [characterId], references: [id])
  Choice    Choice    @relation(fields: [choiceId], references: [id])

  @@id([characterId, choiceId])
}

model Spell {
  id            String       @id
  srd           Boolean      @default(false)
  name          String
  description   String
  duration      String
  range         String
  castingTime   String
  verbal        Boolean      @default(false)
  somatic       Boolean      @default(false)
  material      Boolean      @default(false)
  materialCost  String?
  concentration Boolean      @default(false)
  ritual        Boolean      @default(false)
  upcastInfo    String?
  //search fields
  tags          String[]
  saveRequired  Boolean      @default(false)
  damageType    DamageTypes?
  aoe           Boolean      @default(false)
  conditions    String[]
  options       String[] // If the spell has options to choose from, list here  
  /// [Table]
  extendedTable Json[] // This table will be rendered with the spell
  postTableData String? // This is for any additional content that should be displayed after the table
  school        SpellSchool
  level         Int //0 is cantrip, 1-9 are spell levels
  source        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  User                 User?                  @relation(fields: [userId], references: [id])
  userId               String?
  SpellLists           SpellList[]
  Item                 Item[]                 @relation("SpellScroll")
  PreparedByCreature   Creature[]             @relation("CreaturePrepares")
  FreelyCastByCreature Creature[]             @relation("CreatureFreelyCasts")
  CreatureLimitedSpell CreatureLimitedSpell[]

  slug        String      @unique @db.VarChar(200)
  Character   Character[]
  characterId String?
}

model SpellList {
  id          String @id
  name        String
  flavorText  String @db.VarChar(200)
  description String

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Spells    Spell[]
  Classes   Class[]
  SubClass  SubClass[]

  slug String @unique @db.VarChar(200)
}

model Feature {
  id            String        @id
  workshopId    String?       @unique
  WorkshopItem  WorkshopItem? @relation(fields: [workshopId], references: [id])
  name          String
  description   String
  options       String[]
  /// [Table]
  extendedTable Json[]
  postTableData String?
  levels        Int[]
  /// [RollRequest]
  rolls         Json[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  SubClass                SubClass?                 @relation("SubClassFeatures", fields: [subClassId], references: [id])
  subClassId              String?
  SpellCastingSubclass    SubClass?                 @relation("SpellCastingFeatures", fields: [spellCastingSubclassId], references: [id])
  spellCastingSubclassId  String?
  Species                 Species?                  @relation(fields: [speciesId], references: [id])
  speciesId               String?
  Class                   Class?                    @relation("ClassFeatures", fields: [classId], references: [id])
  classId                 String?
  SpellCastingClass       Class?                    @relation("SpellCastingFeatures", fields: [spellCastingClassId], references: [id])
  spellCastingClassId     String?
  Feat                    Feat?                     @relation(fields: [featId], references: [id])
  featId                  String?
  Tool                    Tool?                     @relation(fields: [toolId], references: [id])
  toolId                  String?
  Item                    Item?                     @relation(fields: [itemId], references: [id])
  itemId                  String?
  Armor                   Armor?                    @relation(fields: [armorId], references: [id])
  armorId                 String?
  FeatureCollection       FeatureCollection?        @relation(fields: [featureCollectionId], references: [id])
  featureCollectionId     String?
  Creature                Creature?                 @relation(fields: [creatureId], references: [id])
  creatureId              String?
  SubSpecies              SubSpecies?               @relation(fields: [subSpeciesId], references: [id])
  subSpeciesId            String?
  Background              Background?               @relation(fields: [backgroundId], references: [id])
  backgroundId            String?
  Weapon                  Weapon?                   @relation(fields: [weaponId], references: [id])
  weaponId                String?
  columnedFeatures        ColumnedFeature[]
  SubClassColumnedFeature SubClassColumnedFeature[]
}

model ColumnedFeature {
  id        String   @id
  classId   String
  Class     Class    @relation(fields: [classId], references: [id])
  featureId String
  Feature   Feature  @relation(fields: [featureId], references: [id])
  name      String
  rows      String[]
}

model SubClassColumnedFeature {
  id         String   @id
  subClassId String
  SubClass   SubClass @relation(fields: [subClassId], references: [id])
  featureId  String
  Feature    Feature  @relation(fields: [featureId], references: [id])
  name       String
  rows       String[]
}

model SubClass {
  id  String  @id
  srd Boolean @default(false)

  name        String
  description String
  flavorText  String @db.VarChar(200)
  source      String @default("Player's Handbook")

  /// [SpellCastingInfo]
  spellCastingInfo Json? //only exists if isSpellCaster is true
  spellList        SpellList? @relation(fields: [spellListId], references: [id]) // If the class has a spell list, link it here
  spellListId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Class   Class   @relation(fields: [classId], references: [id])
  classId String
  User    User?   @relation(fields: [userId], references: [id])
  userId  String?

  Character               Character[]               @relation("Character subClasses")
  Features                Feature[]                 @relation("SubClassFeatures")
  SpellCastingFeatures    Feature[]                 @relation("SpellCastingFeatures")
  SubClassColumnedFeature SubClassColumnedFeature[]

  WorkshopItem WorkshopItem? @relation(fields: [workshopId], references: [id])
  workshopId   String?       @unique

  slug String @unique @db.VarChar(200)
}

model Species {
  id          String  @id
  srd         Boolean @default(false)
  name        String
  description String
  flavorText  String  @db.VarChar(200)
  source      String

  Features Feature[]

  /// [AbilityScoreChoice]
  abilityScores           Json
  abilityScoreDescription String

  creatureType    CreatureType
  size            Size
  sizeDescription String?

  age       String
  alignment String

  /// [SkillChoice]
  skillProficiencies          Json?
  skillProficiencyDescription String?

  /// [ToolChoice]
  toolProficiencies            Json?
  /// [WeaponChoice]
  weaponProficiencies          Json? // Weapon IDs
  weaponProficiencyDescription String?

  speed       Int
  flightSpeed Int?
  swimSpeed   Int?
  climbSpeed  Int?

  speedDescription  String
  flightDescription String?
  swimDescription   String?
  climbDescription  String?

  darkvision            Int?
  darkvisionDescription String?

  resistanceTo DamageTypes[]
  immuneTo     DamageTypes[]
  vulnerableTo DamageTypes[]

  /// [LanguageChoice]
  originLanguages     Json
  languageDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Variants SubSpecies[]

  User      User?       @relation(fields: [userId], references: [id])
  userId    String?
  Character Character[]

  slug String @unique @db.VarChar(200)
}

model SubSpecies {
  id                      String  @id
  srd                     Boolean @default(false)
  name                    String
  description             String
  flavorText              String  @db.VarChar(200)
  source                  String
  /// [AbilityScoreChoice]
  abilityScores           Json?
  abilityScoreDescription String?

  Features      Feature[]
  removedTraits String[] // A list of traits that are removed from the base race. Case sensitive

  creatureType    CreatureType?
  size            Size?
  sizeDescription String?

  age       String?
  alignment String?

  /// [SkillChoice]
  skillProficiencies          Json?
  skillProficiencyDescription String?

  /// [ToolChoice]
  toolProficiencies            Json?
  toolProficiencyDescription   String?
  /// [WeaponChoice]
  weaponProficiencies          Json?
  weaponProficiencyDescription String?

  speed       Int?
  flightSpeed Int?
  swimSpeed   Int?
  climbSpeed  Int?

  speedDescription  String?
  flightDescription String?
  swimDescription   String?
  climbDescription  String?

  darkvision            Int?
  darkvisionDescription String?

  resistanceTo DamageTypes[]
  immuneTo     DamageTypes[]
  vulnerableTo DamageTypes[]

  /// [LanguageChoice]
  originLanguages     Json?
  languageDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  species   Species     @relation(fields: [speciesId], references: [id])
  speciesId String
  Character Character[]

  slug String @unique @db.VarChar(200)
}

model Background {
  id String @id

  srd                            Boolean  @default(false)
  name                           String
  description                    String
  source                         String   @default("Player's Handbook")
  flavorText                     String   @db.VarChar(200)
  /// [SkillChoice]
  skillProficiencies             Json?
  skillProficiencyDescription    String?
  /// [ToolChoice]
  toolProficiencies              Json?
  toolProficiencyDescription     String?
  /// [LanguageChoice]
  languageProficiencies          Json?
  languageProficiencyDescription String?
  /// [ItemChoice]
  equipment                      Json?
  equipmentDescription           String[]

  Features                 Feature[]
  suggestedCharacteristics String?
  traits                   String[]
  ideals                   String[]
  bonds                    String[]
  flaws                    String[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  User                     User?         @relation(fields: [userId], references: [id])
  userId                   String?
  Character                Character[]
  WorkshopItem             WorkshopItem? @relation(fields: [workshopItemId], references: [id])
  workshopItemId           String?       @unique
  slug                     String        @unique @db.VarChar(200)
}

model Feat {
  id           String        @id
  workshopId   String?       @unique
  WorkshopItem WorkshopItem? @relation(fields: [workshopId], references: [id])
  name         String

  Features          Feature[]
  flavorText        String    @db.VarChar(200)
  source            String
  /// [Prerequisite]
  prerequisites     Json?
  prereqDescription String

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  User       User?       @relation(fields: [userId], references: [id])
  userId     String?
  Characters Character[]

  slug String @unique @db.VarChar(200)
}

model Message {
  id        String   @id
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  email     String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id   String @id
  name String

  /// [ToolSkill]
  skills Json[]

  components            String[] // Some tools have components that the character gets. These will be automatically added into the characters sheet
  componentsDescription String? // Description of the components

  Features Feature[]

  Items Item[]

  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ItemTypes {
  MAGIC
  CLOTHES
  ARCANE_FOCUS
  DRUIDIC_FOCUS
  HOLY_SYMBOL
  CONTAINER
  WEAPON
  ARMOR
  AMMUNITION
  COMPONENT_POUCH
  SPELL_BOOK
  EXPLOSIVE
  EQUIPMENT_PACK
  MISC
  TOOL
  CURRENCY
  SPELL_SCROLL
  GEMSTONE
  WONDROUS_ITEM
  AMULET
  BELT
  BOOTS
  BRACERS
  CLOAK
  WORKSHOP
}

enum Unit {
  lb
  oz
  pint
  quart
  gal
}

model EquipmentPack {
  id   String @id
  name String

  /// [QuantityItem]
  itemsQuantity Json[] //describes how many of each item is in the pack
  itemList      Item[] @relation("EquipmentPackParent")

  items Item[] @relation("EquipmentPackChild")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id                 String  @id
  name               String
  description        String
  slug               String  @unique @db.VarChar(200)
  flavorText         String  @db.VarChar(200)
  requiresAttunement Boolean @default(false)
  rarity             Rarity
  /// [CurrencyAmount]
  cost               Json?

  /// [QuantityUnit]
  weight Json?

  /// [QuantityUnit]
  capacity Json?

  // unique item storage

  /// [QuantityItem]
  customItemCapacity Json?

  Features Feature[]

  types ItemTypes[]

  // the item can be part of an equipment pack
  EquipmentPackList EquipmentPack[] @relation("EquipmentPackParent")
  //the item can be an equipment pack
  EquipmentPack     EquipmentPack?  @relation("EquipmentPackChild", fields: [equipmentPackId], references: [id])
  equipmentPackId   String?

  // if the item is a tool we can link it to the tool model
  Tool   Tool?   @relation(fields: [toolId], references: [id])
  toolId String?

  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  Spell   Spell?  @relation("SpellScroll", fields: [spellId], references: [id])
  spellId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  AmmunitionFor Weapon[] @relation("WeaponAmmunition")
  Armor         Armor?   @relation("ItemArmor", fields: [armorId], references: [id])
  armorId       String?

  CreatureWielding Creature[]      @relation("CreatureWields")
  CreatureArmor    Creature[]      @relation("CreatureArmor")
  CreatureShield   Creature[]      @relation("CreatureShield")
  ItemWeaponData   ItemWeaponData?

  workshopId   String?       @unique
  WorkshopItem WorkshopItem? @relation(fields: [workshopId], references: [id])
}

model ItemWeaponData {
  itemId   String  @unique
  Item     Item    @relation(fields: [itemId], references: [id])
  weaponId String
  Weapon   Weapon  @relation(fields: [weaponId], references: [id])
  silvered Boolean @default(false)
  magical  Boolean @default(false)

  @@id([itemId, weaponId])
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
  ARTIFACT
}

//es Finessed, Light, Thrown etc
model WeaponProperty {
  id                     String                   @id
  name                   String
  description            String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  WeaponPropertyInstance WeaponPropertyInstance[]
}

model WeaponPropertyInstance {
  // composite key
  weaponId   String
  propertyId String
  Weapon     Weapon         @relation(fields: [weaponId], references: [id])
  Property   WeaponProperty @relation(fields: [propertyId], references: [id])
  range      String?

  /// [Damage]
  versatileDamage Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([weaponId, propertyId])
}

model Weapon {
  id   String @id
  name String

  // if the weapon is simple or martial
  isSimple Boolean
  isRanged Boolean?

  /// [Damage]
  damage Json[] // AND array (ex 1d6 piercing and 2d6 fire)

  ammunition   Item?   @relation("WeaponAmmunition", fields: [ammunitionId], references: [id])
  ammunitionId String?

  SpecialProperties      Feature[]
  WeaponPropertyInstance WeaponPropertyInstance[]
  ItemWeaponData         ItemWeaponData[]
}

model Armor {
  id   String @id
  name String

  armorClass Int
  armorType  ArmorType

  // AND array (ex disadvantage on stealth checks)

  Features Feature[]
  Item     Item[]    @relation("ItemArmor")
}

//This represents a list of features that will typically be chosen from
// Ex. Eldritch Invocations, Fighting Styles, etc.
model FeatureCollection {
  id          String @id
  name        String
  description String
  flavorText  String @db.VarChar(200)

  Features  Feature[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BlogPost {
  id              String   @id
  title           String
  route           String   @unique
  meta            String   @db.VarChar(200)
  flavorText      String   @db.VarChar(400)
  content         String //markdown
  /// [TableOfContentItem]
  tableOfContents Json[] // array of objects with title and link
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ImageURL String
  ImageAlt String
}

enum CommentType {
  COMMENT
  REPLY
}

enum AssociatedModel {
  ITEM
  FEAT
  CLASS
  SUBCLASS
  SPECIES
  SUBSPECIES
  BACKGROUND
  SPELL
  SPELL_LIST
  CREATURE
}

model Comment {
  id      String @id
  User    User   @relation(fields: [userId], references: [id])
  userId  String
  comment String

  parentComment   Comment?  @relation("ParentComment", fields: [parentCommentId], references: [id])
  parentCommentId String?
  replies         Comment[] @relation("ParentComment")
  likedBy         User[]    @relation("LikedComments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CommentType CommentType
  model       AssociatedModel

  modelId String
}

enum ArmorClassProtocol {
  REGULAR
  NATURAL_ARMOR
}

model Creature {
  id          String @id
  name        String
  description String
  flavorText  String @db.VarChar(200)
  STR         Int
  DEX         Int
  CON         Int
  INT         Int
  WIS         Int
  CHA         Int

  languageDescription String?

  armorClassDescription String?
  armorClassProtocol    ArmorClassProtocol @default(REGULAR)
  shield                Boolean            @default(false)
  naturalArmorBonus     Int?

  hitDiceAmount Int

  creatureType         CreatureType
  size                 Size
  alignmentDescription String?
  alignmentOptions     Alignment[]

  spellcastingAbility Ability?
  casterLevel         Int?

  saveProficiencies Ability[]

  skillProficiencies Skill[]
  skillExpertise     Skill[]

  wieldingItems Item[] @relation("CreatureWields")

  armorEquipped   Item?   @relation("CreatureArmor", fields: [armorEquippedId], references: [id])
  armorEquippedId String?

  shieldEquipped   Item?   @relation("CreatureShield", fields: [shieldEquippedId], references: [id])
  shieldEquippedId String?

  spellsPrepared Spell[] @relation("CreaturePrepares")
  freeSpells     Spell[] @relation("CreatureFreelyCasts")

  speed                     Int
  speedDescription          String?
  climbingSpeed             Int?
  climbingSpeedDescription  String?
  flyingSpeed               Int?
  flyingSpeedDescription    String?
  swimmingSpeed             Int?
  swimmingSpeedDescription  String?
  burrowingSpeed            Int?
  burrowingSpeedDescription String?

  darkvision            Int?
  darkvisionDescription String?

  blindsight            Int?
  blindsightDescription String?

  trueSight            Int?
  trueSightDescription String?

  tremorsense            Int?
  tremorsenseDescription String?

  challengeRating Float

  damageImmunities      DamageTypes[]
  damageResistances     DamageTypes[]
  damageVulnerabilities DamageTypes[]

  conditionImmunities String[]

  legendaryActionAmount Int?
  /// [LegendaryAction]
  legendaryActions      Json[]

  Features Feature[]

  /// [CreatureAction]
  actions Json[]

  CreatureLimitedSpells CreatureLimitedSpell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?

  slug String @unique @db.VarChar(200)
}

enum Time {
  ACTION
  BONUS_ACTION
  REACTION
  ROUND
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

model CreatureLimitedSpell {
  creatureId String
  spellId    String
  amount     Int
  time       Time
  Creature   Creature @relation(fields: [creatureId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Spell      Spell    @relation(fields: [spellId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([creatureId, spellId])
}

enum WorkshopProtocol {
  SPELL
  ITEM
  CREATURE
  CLASS
  SUBCLASS
  SPECIES
  SUBSPECIES
  BACKGROUND
  FEAT
  FEATURE
}

model WorkshopItem {
  id   String @id
  /// [WorkshopItemData]
  data Json

  User   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())
  Feature   Feature?
  Feat      Feat?

  Item       Item?
  SubClass   SubClass?
  Background Background?
}

//Prisma wont create enum types if they are not in a model, so this is a dummy model
model Enums {
  id                 Int                @id @default(autoincrement())
  protocol           WorkshopProtocol
  skill              Skill
  ability            Ability
  armorType          ArmorType
  size               Size
  spellSchool        SpellSchool
  currency           Currency
  damageTypes        DamageTypes
  creatureType       CreatureType
  alignment          Alignment
  language           Language
  rarity             Rarity
  itemTypes          ItemTypes
  unit               Unit
  commentType        CommentType
  associatedModel    AssociatedModel
  armorClassProtocol ArmorClassProtocol
  conditions         Condition
}
