{
  "name": "dndworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dev": "npm run seed && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "postinstall": "prisma generate",
    "migrate": "env-cmd -f .env.local npx prisma migrate dev",
    "migrate-create": "env-cmd -f .env.local npx prisma migrate dev --create-only",
    "migrate:prod": " npx prisma migrate deploy",
    "generate": "env-cmd -f .env.local npx prisma generate",
    "seed": " env-cmd -f .env.local npx prisma db seed",
    "seed:prod": "npx prisma db seed",
    "nuke": "env-cmd -f .env.local npx tsx scripts/nuke.ts",
    "nuke:prod": "env-cmd -f .env npx tsx scripts/nuke.ts",
    "logs": "vercel logs https://world-ashen.vercel.app/",
    "generate:background": "cd scripts/generateSeeds/Backgrounds && npx tsx backgrounds.ts",
    "reseed-push": "npm run nuke:prod && git push origin main",
    "generate-top-pages": "cd scripts && npx tsx generateTopPages.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "@react-pdf/renderer": "^3.4.4",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/react-pdf": "^7.0.0",
    "@uiw/react-md-editor": "^4.0.4",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "bcrypt": "^5.1.1",
    "bufferutil": "^4.0.8",
    "chalk": "^5.3.0",
    "csv-parser": "^3.0.0",
    "discord.js": "^14.16.3",
    "dompurify": "^3.1.5",
    "formik": "^2.4.6",
    "fuse.js": "^7.0.0",
    "inquirer": "^11.0.2",
    "interweave": "^13.1.0",
    "jose": "^5.6.3",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "marked": "^13.0.1",
    "next": "14.2.4",
    "prisma": "^5.16.1",
    "prisma-json-types-generator": "^3.0.4",
    "react": "^18.3.1",
    "react-dom": "^18",
    "react-pdf": "^9.1.0",
    "react-pdf-tailwind": "^2.3.0",
    "simplemde": "^1.11.2",
    "tailwindcss-scoped-groups": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "uuid": "^10.0.0",
    "yup": "^1.4.0",
    "zlib-sync": "^0.1.9"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/lodash": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.9",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "daisyui": "^4.12.10",
    "env-cmd": "^10.1.0",
    "eslint-config-next": "^15.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "node-loader": "^2.0.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "puppeteer": "^23.0.2",
    "tailwindcss": "^3.4.1"
  }
}
